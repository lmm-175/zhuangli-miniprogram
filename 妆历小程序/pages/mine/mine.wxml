<view class="app">
  <nav-bar title="我的"></nav-bar>

  <view class="body tight">
    <view class="card tight row">
      <!-- ⚠️ 2026-09-30（第十七处）：原先这里**写死一个「示」**，
           改了昵称头像首字也不动。现在由 artistStore.initialOf(nickname) 算
           （一处实现，⛔ 不各页 slice(0,1) 一遍）。
           ⛔ 这张卡片**故意不显示简介**：它是她自己这个 Tab 的页头，
              塞 200 字会把它整个撑开；正文点「我的资料」就看得到。 -->
      <view class="ava sm">{{artist.initial}}</view>
      <view style="flex:1;min-width:0">
        <view style="font-size:31rpx;font-weight:700">{{artist.nickname}}</view>
        <view class="meta">{{artist.city}} · {{artist.style_text}}</view>
      </view>
    </view>

    <view class="grp">
      <view class="cell" bindtap="goProfile" hover-class="btn-hover" hover-stay-time="80">
        <text class="cl">我的资料</text><text class="cr">›</text>
      </view>
      <view class="cell" bindtap="goSettings" hover-class="btn-hover" hover-stay-time="80">
        <text class="cl">设置</text><text class="cr">›</text>
      </view>
      <view class="cell" bindtap="goAbout" hover-class="btn-hover" hover-stay-time="80">
        <text class="cl">关于妆历</text><text class="cr">›</text>
      </view>
      <view class="cell" bindtap="switchRole" hover-class="btn-hover" hover-stay-time="80">
        <text class="cl">切换身份</text><text class="cr">约妆 / 妆师 ›</text>
      </view>
    </view>
  </view>
</view>

<!-- 我的资料（妆师端 · 可编辑）
     落点：「我的」Tab →「我的资料」行。落点源是 pages/mine/mine.js 的 goProfile。
     ⚠️ 界面稿 §9.4 的 14 个可点元素里没有这一屏 —— 这一页是后补的，
        因为「我的」页那一行原先只弹一句 toast、不跳页面。见 README §4 第十四处。

     📌 2026-09-30（第十七处）：整页从【只读】改成【可编辑】。
        上一版这里写着「整页没有一个可点的键，所以不可能『点了没反应』」——
        那句话现在是【反的】：这一页正好有 4 个键。所以它得守住对面那条：
        **每一个键都要有着落，每一条失败路径都要出声**（规矩 22）。
        · 昵称 / 常驻城市 → 弹框，原地改完
        · 接妆风格 → style-edit（5 组 16 个预设 chip 多选 **＋ 每组可自填**）
        · 简介 → intro-edit（200 字以内）
        ⛔ 头那张卡片（`.ava` + 昵称 + 城市·风格）**故意不加手势** ——
           头像是整块冻结的（云开发方案，等 M0 过审），给它手势就是假承诺。

     🔴 四个字段就是**客人在分享页上看到的那四个**（landing.wxml 同一个对象，
        同一个 `getArtist()`）；别的字段一律不上这一页，尤其微信号。
        ⛔ 这一页永远不许出现 `ARTIST_CONTACT` / `wechat_id` / `contact.js`。 -->
<view class="app">
  <nav-bar title="我的资料" back="{{true}}"></nav-bar>

  <view class="body tight">
    <view class="card tight row">
      <view class="ava sm">{{artist.initial}}</view>
      <view style="flex:1;min-width:0">
        <view style="font-size:31rpx;font-weight:700">{{artist.nickname}}</view>
        <view class="meta">{{artist.city}} · {{artist.style_text}}</view>
      </view>
    </view>

    <!-- ⚠️ 四行都用同一套长相（值 + 「›」+ hover），⛔ 不给「开弹框的」和
         「跳页的」两副面孔 —— 长得不一样的那些，用户会认定其中一半不能点。 -->
    <view class="grp">
      <view class="cell" bindtap="editNickname" hover-class="btn-hover" hover-stay-time="80">
        <text class="cl">昵称</text><text class="cr">{{artist.nickname}} ›</text>
      </view>
      <view class="cell" bindtap="editCity" hover-class="btn-hover" hover-stay-time="80">
        <text class="cl">常驻城市</text><text class="cr">{{artist.city}} ›</text>
      </view>
      <view class="cell" bindtap="goStyle" hover-class="btn-hover" hover-stay-time="80">
        <text class="cl">接妆风格</text><text class="cr">{{artist.style_text}} ›</text>
      </view>
      <!-- 简介这一行只报【字数】，⛔ 不渲染正文：200 字会把这一页整个撑开，
           而正文本来就该在 intro-edit 里看、在分享页上给客人看。 -->
      <view class="cell" bindtap="goIntro" hover-class="btn-hover" hover-stay-time="80">
        <text class="cl">简介</text>
        <text class="cr">{{introLen ? '已填 ' + introLen + ' 字' : '未填'}} ›</text>
      </view>
    </view>

    <view class="hint">这四项就是客人在你的分享页上看到的信息。四行都能点，改完当场存下。</view>
  </view>
</view>

<!-- 我的预约（约妆端）。顾客自己提交过的预约单。
     ⚠️ 2026-10-01（第二十一处第二轮）：它从「我的」页的**下一层升成了 tab 页**
        （约妆端第 2 格，用户原话「底栏变成三个，把我的预约也放进去」）。
        两个连带：
        ① ⛔ **没有返回箭头**了（tab 页没有「上一页」这回事）；
        ② 根容器带 `tabbed` —— 自定义 tabBar 不会替页面扣底部高度，
           少了它空态那颗「去找妆位」会被压在条子底下（见 app.wxss 的 .app.tabbed）。 -->
<view class="app tabbed">
  <nav-bar title="我的预约"></nav-bar>

  <view class="body tight">
    <block wx:if="{{list.length}}">
      <view class="grp">
        <view wx:for="{{list}}" wx:key="id" class="bk-cell">
          <view style="flex:1;min-width:0">
            <view class="bk-ev">{{item.event}}</view>
            <view class="bk-sl">{{item.slot}}</view>
          </view>
          <view class="st st-{{item.status}}">{{item.statusText}}</view>
        </view>
      </view>
      <view class="hint">提交后妆娘会主动联系你。<br />如果很久没人联系，可以从妆位页加妆娘的微信。</view>
    </block>

    <view wx:else class="body center" style="flex:1">
      <view class="empty">
        <text class="ic">📋</text>
        <view class="et">还没有预约单</view>
        <view style="font-size:26rpx">从妆位页选一个妆位填单后<br />会出现在这里</view>
      </view>
      <view class="btn pri" style="margin:0 26rpx" bindtap="goHome" hover-class="btn-hover" hover-stay-time="80">去找妆位</view>
    </view>
  </view>
</view>
